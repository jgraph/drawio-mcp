{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.draw/mcp",
  "title": "draw.io",
  "description": "draw.io diagrams from Mermaid, XML, PlantUML or CSV, in chat or the editor. Fast mode for drafts.",
  "repository": {
    "url": "https://github.com/jgraph/drawio-mcp",
    "source": "github"
  },
  "version": "1.10.0",
  "websiteUrl": "https://www.drawio.com",
  "icons": [
    {
      "src": "https://www.drawio.com/img/logo.svg",
      "mimeType": "image/svg+xml",
      "sizes": ["any"]
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@drawio/mcp",
      "version": "1.13.1",
      "transport": {
        "type": "stdio"
      }
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.draw.io/mcp"
    }
  ]
}
